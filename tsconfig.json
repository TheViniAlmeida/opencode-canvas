{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun-types"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/index.ts",
    "src/plugin/**/*.ts",
    "src/canvas/cli.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
