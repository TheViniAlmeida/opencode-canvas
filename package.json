{
  "name": "@mailshieldai/opencode-canvas",
  "version": "0.1.2",
  "description": "Interactive terminal canvases for OpenCode - calendars, documents, flight booking",
  "author": {
    "name": "Harsha",
    "email": "harsha@example.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target bun --packages external && tsc -p tsconfig.build.json",
    "start": "bun run src/canvas/cli.ts",
    "show": "bun run src/canvas/cli.ts show",
    "spawn": "bun run src/canvas/cli.ts spawn",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test:tmux": "bun scripts/smoke-tmux.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheViniAlmeida/opencode-canvas.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "media",
    "run-canvas.sh",
    ".opencode/skill",
    "server.js"
  ],
  "dependencies": {
    "commander": "^14.0.2",
    "ink": "^6.6.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.3",
    "@opencode/plugin": "2.0.22"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^19.2.7",
    "bun-types": "latest",
    "typescript": "^5"
  },
  "keywords": [
    "opencode",
    "plugin",
    "canvas",
    "tui",
    "terminal",
    "calendar",
    "document",
    "flight"
  ],
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "engines": {
    "bun": ">=1.3.2"
  }
}
